{
  "name": "liquid-glass",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "vercel dev",
    "build": "node scripts/build-push.mjs --check && vite build && node scripts/build-sw.mjs && node scripts/check-shots-bypass.mjs",
    "build:push": "node scripts/build-push.mjs",
    "build:icons": "node scripts/build-phosphor.mjs",
    "check:rules": "tsx scripts/check-rules.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc -b --force",
    "preview": "vite preview",
    "mcp": "tsx mcp/index.ts",
    "shots": "tsx scripts/screenshots.ts",
    "shots:update": "tsx scripts/screenshots.ts --update",
    "shots:accept": "tsx scripts/screenshots.ts --accept",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@google/genai": "^2.16.0",
    "@react-oauth/google": "^0.13.5",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.2.0",
    "framer-motion": "^12.42.0",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "web-push": "^3.6.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@phosphor-icons/core": "^2.1.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@vercel/node": "^5.9.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.2",
    "esbuild": "^0.27.7",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "jose": "^5.10.0"
  }
}
