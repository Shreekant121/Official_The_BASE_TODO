{
  /*
   * The MCP server (item 9). Its own project rather than a folder added to
   * `tsconfig.node.json`, because it is the one thing in this repo that is
   * both halves at once: it runs on Node, so it needs Node's globals and none
   * of the DOM's, and it imports the app's own store and tool layer out of
   * `src/`, which `tsconfig.app.json` compiles against `DOM`.
   *
   * `moduleResolution: bundler` rather than Node's, because everything it
   * imports out of `src/` is written with extensionless specifiers. `tsx`,
   * which is what actually runs this, resolves them the same way — so the
   * checker and the runtime agree.
   *
   * `lib` deliberately does NOT include `DOM`. That is the point: it is what
   * fails the build if something browser-only is ever pulled into this import
   * graph, rather than letting it through to throw at runtime on the laptop.
   */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.mcp.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["mcp", "server"]
}
